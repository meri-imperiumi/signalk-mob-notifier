{
  "name": "@meri-imperiumi/signalk-mob-notifier",
  "version": "1.1.8",
  "description": "Create Signal K notifications for discovered AIS MOB, EPIRB, and SART beacons",
  "main": "plugin/index.js",
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true plugin/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write plugin/ test/",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/meri-imperiumi/signalk-mob-notifier.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-ais",
    "signalk-category-notifications"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/meri-imperiumi/signalk-mob-notifier/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/meri-imperiumi/signalk-mob-notifier#readme",
  "dependencies": {
    "where": "^1.0.0"
  },
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "appIcon": "./doc/appicon-256.png",
    "displayName": "AIS MOB and EPIRB notifier",
    "screenshots": [
      "./doc/alert.png"
    ],
    "recommends": [
      "@meri-imperiumi/signalk-meshtastic",
      "@meri-imperiumi/signalk-audio-notifications"
    ]
  }
}
